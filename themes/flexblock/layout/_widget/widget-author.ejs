<%
  var langPosts = lang_posts(page_lang());
  var langCategories = site.categories.filter(function (c) { return langPosts.some(function (p) { return p.categories.some(function (pc) { return pc._id === c._id }) }) });
  var langTags = site.tags.filter(function (t) { return langPosts.some(function (p) { return p.tags.some(function (pt) { return pt._id === t._id }) }) });
%>
<section class="widget-author widget-item layout-margin content-padding--primary soft-size--large soft-style--box">
  <div class="widget-body">
    <% if (theme.author.avatar) { %>
      <img src="<%= theme.author.avatar %>" class="soft-size--round soft-style--box" alt="<%= theme.author.name %>">
    <% } %>
    <% if (theme.author.name) { %>
      <h2><%= theme.author.name %></h2>
    <% } %>
    <p><%= __('author_desc') %></p>

    <div class="count-box">
      <div class="count-box--item">
        <%- partial("../_svg/icon-article.svg") %>
        <span><%= langPosts.length %></span>
      </div>
      <div class="count-box--item">
        <%- partial("../_svg/icon-categories.svg") %>
        <%= langCategories.length %>
      </div>
      <div class="count-box--item">
        <%- partial("../_svg/icon-tags.svg") %>
        <%= langTags.length %>
      </div>
    </div>
  </div>
</section>
