<!-- footer container -->
<footer id="footer" class="footer">
  <div class="footer-container">
    <% if (theme.social_icon.enable) { %>
    <div class="social-icons">
      <% for (var i in theme.social_icon.icons) { %>
        <% if (theme.social_icon.icons[i]) { %>
          <a href="<%= theme.social_icon.icons[i] %>" class="soft-size--primary soft-style--box" target="_blank" rel="noopener noreferrer">
            <%- partial("../_svg/social-"+ i +".svg") %>
          </a>
        <% } %>
      <% } %>
    </div>
    <% } %> 
    <p>&copy; <%= date(new Date(), 'YYYY') %> <a href="/" target="_blank"><%= config.author %></a></p>

    <% if (theme.mermaid.enable && page.mermaid) { %>
      <script src='<%= theme.mermaid.cdn %>'></script>
      <script>
        if (window.mermaid) {
          mermaid.initialize({
            startOnLoad: true,
            theme: '<%= theme.mermaid.theme || 'neutral' %>',
          });
        }
      </script>
    <% } %>

    <% if (theme.beian) { %>
      <p><a href="https://beian.miit.gov.cn" target="_blank"><%= theme.beian %></a></p>
    <% } %>

    <p>Powered by <a href="https://hexo.io" target="_blank" rel="noopener noreferrer">Hexo</a> | Article Publishing by  - <a href="https://github.com/GarGarfie" target="_blank" rel="noopener noreferrer author">Shawn</a></p>

    <p>
      <a href="javascript:;" id="theme-light"><%= __('theme_light') %></a>
      <a href="javascript:;" id="theme-dark"><%= __('theme_dark') %></a>
      <a href="javascript:;" id="theme-auto"><%= __('theme_auto') %></a>
    </p>
  </div>
</footer>
